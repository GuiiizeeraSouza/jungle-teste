# Camada de mocks (MSW + Socket.IO simulado). "enabled" ativa os mocks no dev e no build de demonstração.
NEXT_PUBLIC_API_MOCKING=enabled
# Base das APIs REST consumidas via Axios.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Endpoint Socket.IO. Em modo mock, é interceptado pelo MSW (nenhum servidor real é contatado).
NEXT_PUBLIC_REALTIME_URL=wss://realtime.kurio.test
